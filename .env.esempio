# Copia questo file in `.env` e riempilo per provare in locale.
# Il `.env` vero è ignorato da git: non deve mai finire nel repository.
#
# Su Railway questa variabile NON si scrive a mano: la fornisce il
# servizio Postgres, e si aggancia dal pannello con Variables → Add
# Reference. Il valore non deve passare per nessun altro posto.
DATABASE_URL=postgresql://utente:password@host:5432/nomedb
